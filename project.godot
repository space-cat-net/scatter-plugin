; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Scatter3D Plugin"
config/description="Procedural object scattering for Godot 4. Uses Poisson disk sampling with variable radius,
projects onto mesh surfaces via TriangleMesh, and renders/physics instances directly
through RenderingServer and PhysicsServer3D - no Node per instance,
so tens of thousands of objects stay cheap."
config/tags=PackedStringArray("plugin")
run/main_scene="uid://cjugkqirtwl4s"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://c1ses3dggv3rm"

[display]

window/size/sharp_corners=true

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/scatter/plugin.cfg")

[input]

