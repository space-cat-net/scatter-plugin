@tool
@icon('res://addons/scatter/assets/scatter_instance_type.svg')
class_name ScatterInstanceType
extends Resource


## Type of instances, generated by [Scatter3D]
##
## Contains settings and instructions for Scatter3D. You can set mesh,
## generation rules, configure collision and navigation.


## Mesh for all generated instances.
@export var mesh: Mesh
## Probability weigth of generation.
## Increasing values will result more instances of this type.
@export_range(0.0, 1.0, 0.001, 'or_greater', 'hide_control') var generation_weight: float = 1.0
@export_group('Transform')
## Offset in relative space, added to each instance.
@export_custom(PROPERTY_HINT_RANGE, '-1,1,0.001,hide_control,or_greater,suffix:m') var position_offset: Vector3 = Vector3.ZERO
## Random rotation of instances along Y axis.
@export_range(0, 180, 0.001, 'radians_as_degrees') var random_rotation: float = 0.0
## Random tilt of instances along X and Z axis.
@export_range(0, 180, 0.001, 'radians_as_degrees') var random_tilt: float = 0.0
## Base scale of instances.
@export_range(0.001, 1024, 0.001, 'or_greater', 'hide_control') var base_scale: float = 1.0
## Instance scale randomisation. Set 0 to disable.
@export_range(0, 1024, 0.001, 'or_greater', 'hide_control') var random_scale: float = 0.0
@export_group('Filtering')
@export_subgroup('By Normal', 'normal_filtering_')
## Enables normal filtering, so instances can't generate on
## steep surfaces, For example, don't spawn trees on
## mountains.
@export_custom(PROPERTY_HINT_GROUP_ENABLE, '') var normal_filtering_enabled: bool = false
## Target normal for filtering, For example, if set
## to [code]Vector3.UP[/code], it will generate
## only on flat surfaces.
@export var normal_filtering_normal: Vector3 = Vector3.UP
## Maximum angle deviation from target normal in degrees.
@export_range(0, 360, 0.001, 'degrees') var normal_filtering_threshold: float = 15
@export_subgroup('By Height', 'height_filtering_')
## Enables height filtering, so instances will be placed only in given
## range on global vertical (Y) axis.
@export_custom(PROPERTY_HINT_GROUP_ENABLE, '') var height_filtering_enabled: bool = false
## Minimum height, on which instances will be generated. In global space.
@export_range(-1024, 1024, 0.001, 'or_greater', 'or_less', 'suffix:m') var height_filtering_min_height: float = 0
## Maximum height, on which instances will be generated. In global space.
@export_range(-1024, 1024, 0.001, 'or_greater', 'or_less', 'suffix:m') var height_filtering_max_height: float = 10
@export_group('Masking', 'masking_')
## Enables scattering masking using texture.
@export_custom(PROPERTY_HINT_GROUP_ENABLE, '') var masking_enabled: bool = false
## Mask texture for scattering. In darker areas there will be less instances, in bright areas - more.
@export var masking_texture: Texture2D
@export_group('Geometry')
## See [member GeometryInstance3D.cast_shadow]
@export var cast_shadow: RenderingServer.ShadowCastingSetting\
= RenderingServer.ShadowCastingSetting.SHADOW_CASTING_SETTING_ON
## See [member GeometryInstance3D.gi_mode]
@export var gi_mode: GeometryInstance3D.GIMode = GeometryInstance3D.GIMode.GI_MODE_DISABLED
## See [member GeometryInstance3D.lod_bias]
@export_range(0.001, 128.0, 0.001) var lod_bias: float = 1.0
@export_subgroup('Visibility Range', 'visibility_range_')
## See [member GeometryInstance3D.visibility_range_begin]
@export_range(0, 4096, 0.001, 'or_greater', 'suffix:m')
var visibility_range_begin: float = 0.0
## See [member GeometryInstance3D.visibility_range_begin_margin]
@export_range(0, 4096, 0.001, 'or_greater', 'suffix:m')
var visibility_range_begin_margin: float = 0.0
## See [member GeometryInstance3D.visibility_range_end]
@export_range(0, 4096, 0.001, 'or_greater', 'suffix:m')
var visibility_range_end: float = 0.0
## See [member GeometryInstance3D.visibility_range_end_margin]
@export_range(0, 4096, 0.001, 'or_greater', 'suffix:m')
var visibility_range_end_margin: float = 0.0
## See [member GeometryInstance3D.visibility_range_fade_mode]
@export var visibility_range_fade_mode: RenderingServer.VisibilityRangeFadeMode\
= RenderingServer.VisibilityRangeFadeMode.VISIBILITY_RANGE_FADE_DISABLED
@export_group('Collision', 'collision_')
## Mode of collision shape of instance. If set to
## [enum Scatter3D.CollisionShapeMode.DISABLED], disables collision at all.
## Else, [Scatter3D] will generate collisions for all instances.
## Collision generation has heavy performance impact on generation,
## but not on population.
@export var collision_shape_mode: Scatter3D.CollisionShapeMode = Scatter3D.CollisionShapeMode.DISABLED:
	set(val): collision_shape_mode = val; notify_property_list_changed()
## Custom instance collision shape.
@export var collision_shape: Shape3D
@export_flags_3d_physics var collision_layer: int = 0b00000000_00000000_00000000_00000001
@export_flags_3d_physics var collision_mask: int = 0b00000000_00000000_00000000_00000001
@export_group('Navigation', 'navigation_')
## If enabled, [Scatter3D] will generate navigation obstacles for all instances
## of this type. It creates dynamic obstacles using radius, and don't affect
## NavigationMesh. To make agents avoid this obstacles, enable
## their [member NavigationAgent3D.avoidance_enabled].
@export_custom(PROPERTY_HINT_GROUP_ENABLE, '') var navigation_enabled: bool = false
## See [member NavigationObstacle3D.radius]
@export_range(0, 100, 0.01) var navigation_radius: float = 1.0
@export_subgroup('Avoidance')
## See [member NavigationObstacle3D.avoidance_enabled]
@export var navigation_avoidance_enabled: bool = true
## See [member NavigationObstacle3D.avoidance_layers]
@export_flags_avoidance var navigation_avoidance_layers: int = 0b00000000_00000000_00000000_00000001
## See [member NavigationObstacle3D.use_3d_avoidance]
@export var navigation_use_3d_avoidance: bool = false

## Returns, can this resource be used in scattering.
func is_valid() -> bool:
	return is_instance_valid(mesh)

func _validate_property(property: Dictionary) -> void:
	if property.name in [&'collision_shape']\
		and collision_shape_mode != Scatter3D.CollisionShapeMode.CUSTOM:
			property.usage = PROPERTY_USAGE_NONE
	if property.name in [&'collision_layer', &'collision_mask']\
		and collision_shape_mode == Scatter3D.CollisionShapeMode.DISABLED:
			property.usage = PROPERTY_USAGE_NONE
	
